+<!doctype html>
+<html lang="tr"><head><meta charset="utf-8"><title>{{ deneme.ad }}</title>
+<style>body{font-family:DejaVu Sans,sans-serif;font-size:12px;color:#111}h1{font-size:18px}table{width:100%;border-collapse:collapse}th,td{border-bottom:1px solid #ddd;padding:6px;text-align:left}th{font-size:10px;text-transform:uppercase;color:#555}.z{color:#b91c1c}</style>
