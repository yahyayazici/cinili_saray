+{% extends "base.html" %}
+{% load static %}
+{% block title %}Talebeler · {{ hoca.ad_soyad }}{% endblock %}
+{% block extra_css %}<link rel="stylesheet" href="{% static 'css/etut-kontrol.css' %}">{% endblock %}
+{% block content %}
+<div class="ek-page">
+  <header class="ek-head">
+    <div>
+      <p class="ek-kicker">Etüt · Talebelerim</p>
+      <h1>{{ hoca.ad_soyad }}</h1>
+      <p class="ek-desc">Talebe kutularına gir; puan grafiği ve deneme kazanımlarını gör. Zayıflar öne çıkar.</p>
+    </div>
+    <div class="ek-actions">
+      <a href="{% url 'etut_kontrol' hoca.id %}" class="ghost-btn">← Etüt Kontrol</a>
+    </div>
+  </header>
+
+  {% if kutular %}
+  <div class="ek-grid">
+    {% for k in kutular %}
+    <a class="ek-box" href="{% url 'etut_kontrol_talebe' hoca.id k.talebe.id %}">
+      <div style="display:flex;justify-content:space-between;gap:.5rem;">
+        <span class="ek-badge">{% if k.talebe.sinif_sube %}{{ k.talebe.sinif_sube.sinif }}-{{ k.talebe.sinif_sube.sube }}{% else %}—{% endif %}</span>
+        <span class="ek-badge">{{ k.trend }}</span>
+      </div>
+      <strong>{{ k.talebe.ad_soyad }}</strong>
+      <div class="ek-muted">Son ortalama</div>
+      <div class="ek-stat">{% if k.son_ortalama %}{{ k.son_ortalama }}%{% else %}—{% endif %}</div>
+      <div class="{% if k.zayif_sayisi %}ek-danger{% else %}ek-ok{% endif %}" style="margin-top:.65rem;font-size:.82rem;">
+        {% if k.zayif_sayisi %}Son denemede {{ k.zayif_sayisi }} zayıf konu{% else %}Zayıf konu yok{% endif %}
+      </div>
+      <div class="ek-muted" style="margin-top:.4rem;font-size:.78rem;">{{ k.deneme_sayisi }} deneme</div>
+    </a>
+    {% endfor %}
+  </div>
+  {% else %}
+  <div class="ek-card"><p class="ek-muted">Bu etütte talebe yok.</p></div>
+  {% endif %}
+</div>
+{% endblock %}
