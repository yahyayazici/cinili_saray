+<p>{{ deneme.sinav_tarihi }} · {{ sekme }}</p>
+{% if sekme == 'siralama' %}
+<table><thead><tr><th>#</th><th>Talebe</th><th>Sınıf</th><th>%</th></tr></thead><tbody>
+{% for row in siralama %}<tr><td>{{ row.sira }}</td><td>{{ row.ad_soyad }}</td><td>{{ row.sinif }}</td><td>{{ row.ortalama }}</td></tr>{% endfor %}
+</tbody></table>
+{% else %}
+<table><thead><tr><th>Ders</th><th>Kazanım</th><th>%</th></tr></thead><tbody>
+{% for row in kazanimlar %}<tr><td>{{ row.ders }}</td><td>{{ row.konu }}</td><td class="{% if row.zayif %}z{% endif %}">{{ row.ortalama }}</td></tr>{% endfor %}
+</tbody></table>
+{% endif %}
+</body></html>
